#!/bin/sh
# 3D lid-driven cavity: base flow (Newton, with Re continuation) + leading
# eigenmode (shift-invert PARPACK).
#
#   ./Allrun                       # 4 MPI ranks, target Re from system/newtonProperties
#   ./Allrun -np 10
#   ./Allrun -np 10 -ramp "250 750 1500"   # own continuation steps
#   ./Allrun -np 10 -ramp none             # Newton directly at the target Re
#   ./Allrun -np 10 -continue -ramp "1750 2000"   # keep the mesh and the last
#                                          # converged base flow, go on from there
#
# Newton from rest converges only at moderate Re, so by default the base flow is
# computed at 200, 500, 1000, then every 250 (1250, 1500, ...) and finally at the
# target Re (on 50^3 the jump 1500 -> 2000 already fails); each step starts
# from the previous solution (NewtonSolver writes it back into the start time).
#
# Grid: 50^3 with sine stretching. Converged reference (256^3, Gelfgat 2019
# stretching): Re_cr ~ 1928.75, omega ~ 0.584. This grid is a quick check.

cd "${0%/*}" || exit 1

NP=4
RAMP=auto
CONTINUE=no
while [ $# -gt 0 ]; do
    case "$1" in
        -np)   NP="$2"; shift 2 ;;
        -ramp) RAMP="$2"; shift 2 ;;
        -continue) CONTINUE=yes; shift ;;
        *) echo "Unknown option $1"; exit 1 ;;
    esac
done

command -v StabilitySolver >/dev/null || { echo "StabilitySolver not found: run ./Allwmake"; exit 1; }

RE=$(foamDictionary system/newtonProperties -entry Re -value)
echo "Target Re = $RE, $NP MPI ranks"

if [ "$RAMP" = auto ]; then
    RAMP=$(awk -v t="$RE" 'BEGIN { n = split("200 500 1000", a, " "); for (i = 1; i <= n; i++) if (a[i] < t) printf "%d ", a[i]; for (r = 1250; r < t; r += 250) printf "%d ", r }')
elif [ "$RAMP" = none ]; then
    RAMP=""
fi

if [ "$CONTINUE" = no ]; then
    foamDictionary system/decomposeParDict -entry numberOfSubdomains -set "$NP" >/dev/null
    blockMesh            > log.blockMesh    2>&1 || { echo "blockMesh failed, see log.blockMesh"; exit 1; }
    decomposePar -force  > log.decomposePar 2>&1 || { echo "decomposePar failed, see log.decomposePar"; exit 1; }
else
    [ -d processor0 ] || { echo "-continue: no processor* folders, run without -continue first"; exit 1; }
    echo "Continuing from the existing mesh and base flow"
fi

for r in $RAMP $RE; do
    echo "NewtonSolver at Re = $r ..."
    foamDictionary system/newtonProperties -entry Re -set "$r" >/dev/null
    if ! mpirun -np "$NP" NewtonSolver -parallel > "log.NewtonSolver.Re$r" 2>&1; then
        foamDictionary system/newtonProperties -entry Re -set "$RE" >/dev/null
        echo "NewtonSolver failed at Re = $r, see log.NewtonSolver.Re$r"
        echo "The last converged base flow is kept. Continue with smaller steps, e.g.:"
        echo "  ./Allrun -np $NP -continue -ramp \"<smaller steps up to $RE>\""
        exit 1
    fi
    grep "^Newton " "log.NewtonSolver.Re$r" | tail -1
done
cp "log.NewtonSolver.Re$RE" log.NewtonSolver

# Stability at the target Re (both dictionaries must agree)
foamDictionary system/stabilityProperties -entry Re -set "$RE" >/dev/null

echo "StabilitySolver at Re = $RE ..."
mpirun -np "$NP" StabilitySolver -parallel > log.StabilitySolver 2>&1 \
    || { echo "StabilitySolver failed, see log.StabilitySolver"; exit 1; }

reconstructPar -latestTime > log.reconstructPar 2>&1

echo "Done. Leading eigenvalue:"
grep -E "selected lambda|growth rate|angular frequency" log.StabilitySolver | tail -3
touch case.foam
echo "Open case.foam in ParaView (fields leadingEigenModeRealU / ImagU)."
